{
  "name": "togisumashi-vim",
  "private": true,
  "scripts": {
    "build:drills": "tsx scripts/build-drills.ts",
    "dev": "pnpm build:drills && pnpm --filter web dev",
    "build": "pnpm build:drills && pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "typecheck": "pnpm --filter web typecheck",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "tsx": "^4.22.3",
    "wrangler": "^4.93.0"
  }
}
